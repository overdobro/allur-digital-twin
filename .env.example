# Ключ Claude API. Без ключа AI-рекомендации работают на шаблонных правилах (офлайн).
ANTHROPIC_API_KEY=
# Модель Claude
ANTHROPIC_MODEL=claude-opus-5-5
# Таймаут запроса к LLM, сек — после него fallback на правила
LLM_TIMEOUT_S=20
# Рабочих дней в месяце для прогноза
WORKING_DAYS=22
# Порт веб-интерфейса
APP_PORT=8080
# Пароль демо-руководителя (логин manager)
MANAGER_PASSWORD=allur2026
# Подпись сессий — на сервере задать случайную строку
SECRET_KEY=change-me
# БД: по умолчанию SQLite в backend/data; на Vercel — Postgres (Neon) подставляется сам
# DATABASE_URL=postgresql://...
